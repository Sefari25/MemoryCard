#подключение библеотек

class Question():
    def __init__(self, question3, right_answer, wrong1, wrong2, wrong3):
        self.question3 = question3
        self.right_answer = right_answer
        self.wrong1 = wrong1
        self.wrong2 = wrong2
        self.wrong3 = wrong3

#класс коробок


def show_result():
    RadioGroupBox2.show()
    RadioGroupBox.hide()
    button.setText('Следующий вопрос')
#меняет коробки

def show_question():
    RadioGroupBox2.hide()
    RadioGroupBox.show()
    button.setText('Ответить')
    RadioButtonBox1.setExclusive(False)
    otvet1.setChecked(False)
    otvet2.setChecked(False)
    otvet3.setChecked(False)
    otvet4.setChecked(False)
    RadioButtonBox1.setExclusive(True)
#выключает виджеты

def start_test():
    if button.text() == 'Ответить':
        show_result()
    else:
        show_question()
#проверяет кнопку

def ask(q: Question):
    shuffle(answers)
    answers[0].setText(q.right_answer)
    answers[1].setText(q.wrong1)
    answers[2].setText(q.wrong2)
    answers[3].setText(q.wrong3)
    question.setText(q.question3)
    pravilniy.setText(q.right_answer)
    show_question()
#перемешивает и задает ответы

def check_answer():
    if answers[0].isChecked():
        pravino_or_net.setText('Правильно')
        main_win.score += 1
    else:
        pravino_or_net.setText('Неверно')
    show_result()
#меняет тескт на правильно/неправильно

def next_question():
    cur_question = randint(0, len(questions_list) -1)
    q = questions_list[cur_question]
    ask(q)
    main_win.total += 1
    print('-Правильных ответов:', main_win.score)
    print('-Всего вопросов:', main_win.total)

#счетчки вопросов

def click_ok():
    if button.text() == 'Ответить':
        check_answer()
    else:
        next_question()
